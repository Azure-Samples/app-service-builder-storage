# Shell environment only: no frontend VITE_ variables and no secrets.
AZURE_STORAGE_BLOB_ENDPOINT=https://youraccount.blob.core.windows.net
AZURE_STORAGE_CONTAINER=filevault
# Local development only; do not set local access mode in Builder.
APP_ACCESS_MODE=local
PORT=8080
# Builder user-assigned identity only:
# AZURE_CLIENT_ID=<identity-client-id>
